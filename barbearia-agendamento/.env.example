# URL de conexão com o PostgreSQL (fornecida pelo Render ao criar o banco)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Porta em que o servidor Express vai rodar (o Render define automaticamente em produção)
PORT=10000

# Segredo usado para assinar os tokens JWT do login administrativo
JWT_SECRET=troque-este-valor-por-um-segredo-forte

# Credenciais iniciais do administrador (usadas apenas pelo script db/setup.js)
ADMIN_NOME=evandro
ADMIN_SENHA=barbearia123
