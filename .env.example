# Copie este arquivo para ".env" e preencha com os valores do seu ambiente.
# Este arquivo (.env.example) pode ir para o GitHub. O arquivo .env NUNCA deve ser commitado.

# String de conexão do PostgreSQL.
# Local (exemplo, ajuste usuário/senha/porta/nome do banco conforme seu Postgres local):
DATABASE_URL=postgresql://sistema_de_agendamento_pum2_user:KyiOEYIsHffyf3VTOn9yOsHFI0IK0I6c@dpg-daj1lc95efls73f96vtg-a.oregon-postgres.render.com/sistema_de_agendamento_pum2

# Porta em que o servidor local vai escutar (em produção o Render define isso sozinho)
PORT=10000

# Senha do usuário "admin" criada automaticamente pelo script de seed, caso ele ainda não exista.
# Depois do primeiro login, é recomendado trocar a senha diretamente no banco de dados.
ADMIN_SENHA_INICIAL=barbearia123
